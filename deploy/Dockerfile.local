FROM public.ecr.aws/docker/library/eclipse-temurin:17-jre-alpine
WORKDIR /app
ENV TZ=Asia/Shanghai
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
COPY --chown=appuser:appgroup target/agent-0.0.1-SNAPSHOT.jar app.jar
USER appuser
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=5 CMD wget -qO- http://127.0.0.1:8080/v3/api-docs > /dev/null || exit 1
ENTRYPOINT ["java", "-jar", "/app/app.jar", "--spring.profiles.active=prod"]
