# 生产环境配置模板
# 复制为 .env.prod 并填入真实值后使用:cp .env.prod.example .env.prod
# .env.prod 已在 .gitignore 中,不入仓库

# DeepSeek API
DEEPSEEK_CLIENT_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 硅基流动 Embedding API
RAG_EMBEDDING_API_KEY=sk-your-siliconflow-key
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_PROVIDER=openai

# 混合检索 + Rerank（默认启用；Rerank 默认复用 Embedding Key）
RAG_HYBRID_ENABLED=true
RAG_HYBRID_RECALL_TOP_K=20
RAG_HYBRID_RRF_K=60
RAG_RERANK_ENABLED=true
RAG_RERANK_PROVIDER=siliconflow
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_TOP_K=3
# 如需独立 Key 再取消注释：
# RAG_RERANK_API_KEY=sk-your-rerank-key

# JWT
JWT_SECRET=your-prod-jwt-secret-at-least-32-chars-long-change-me
JWT_EXPIRATION_MS=86400000

# MySQL(MySQL 容器已配置默认值,这里覆盖 root 密码)
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_DATABASE=agent
MYSQL_USERNAME=agent
MYSQL_PASSWORD=change-agent-password

# Redis
REDIS_PASSWORD=

# Qdrant
QDRANT_URL=http://qdrant:6333

# Swagger(生产环境可关)
SWAGGER_ENABLED=true
