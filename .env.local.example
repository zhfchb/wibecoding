# Copy to ignored .env.local. Do not commit real credentials.
AI_SERVICE_TOKEN=replace-with-a-long-random-internal-token
DEEPSEEK_CLIENT_API_KEY=
AI_MODEL_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
RAG_EMBEDDING_PROVIDER=hash
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
TAVILY_API_KEY=

# Optional container-only HTTP proxy. Internal services always bypass it.
# Example: http://host.docker.internal:9674
AI_HTTP_PROXY=
AI_HTTPS_PROXY=
VECTOR_PROXY_URL=
VECTOR_PROXY_RDNS=false
AI_NO_PROXY=localhost,127.0.0.1,app,ai-service,mysql,redis,qdrant,host.docker.internal,api.siliconflow.cn
# Optional official Python base-image mirror for local builds.
PYTHON_BASE_IMAGE=python:3.12-slim
# Recruitment match task deadline, including queue time (seconds)
MATCH_TASK_TIMEOUT_SECONDS=600
# Failed-resume re-parsing task deadline, including queue time (seconds)
RESUME_PARSE_TASK_TIMEOUT_SECONDS=600
# Interview-question / report task deadline, including queue time (seconds)
MATERIAL_TASK_TIMEOUT_SECONDS=600
